{
  "name": "veerhanuman",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19 <23"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx watch server/src/index.ts",
    "dev:all": "concurrently -n web,api -c cyan,magenta \"npm:dev\" \"npm:dev:api\"",
    "build": "tsc -b && vite build",
    "start": "NODE_ENV=production tsx server/src/index.ts",
    "start:win": "set NODE_ENV=production&& tsx server/src/index.ts",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "lint": "oxlint",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "smoke": "vite build --ssr scripts/ssr-smoke.tsx --outDir .smoke --logLevel warn && node .smoke/ssr-smoke.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate --schema server/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema server/prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema server/prisma/schema.prisma",
    "db:seed": "tsx server/prisma/seed.ts",
    "db:studio": "prisma studio --schema server/prisma/schema.prisma",
    "db:reset": "node server/scripts/guard-destructive.mjs \"prisma migrate reset --schema server/prisma/schema.prisma\"",
    "admin:create": "tsx server/scripts/create-admin.ts",
    "setup": "npm run db:generate && npm run db:deploy && npm run db:seed"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.47.0",
    "multer": "^2.4.0",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "sharp": "^0.35.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "concurrently": "^9.2.4",
    "oxlint": "^1.81.0",
    "playwright": "^1.63.0",
    "postcss": "^8.5.28",
    "prisma": "^7.10.0",
    "supertest": "^7.3.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  }
}
