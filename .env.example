# Copy to .env and fill in. NEVER commit .env.
# Anything the browser needs must start with VITE_; everything else stays
# server-side only.

# ---------------------------------------------------------------- Database
# Postgres in every environment, so development and production cannot drift.
DATABASE_URL="postgresql://postgres:dev@localhost:5432/veerhanuman?schema=public"

# The test suite uses a SEPARATE database and refuses to run against anything
# whose name does not end in _test. Create it once with:
#   createdb veerhanuman_test    (or CREATE DATABASE veerhanuman_test;)
TEST_DATABASE_URL="postgresql://postgres:dev@localhost:5432/veerhanuman_test?schema=public"

# Managed providers (Neon, Supabase, Railway, RDS) usually require TLS:
# DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# ------------------------------------------------------------------ Server
PORT=4000
NODE_ENV=development

# Comma-separated origins allowed to call the API with credentials.
CORS_ORIGINS="http://localhost:5173,http://localhost:5176"

# Fallback canonical origin for sitemap.xml and robots.txt, used only when
# the CMS company profile has no production URL set (Admin > Company &
# Contact). Never taken from the request Host header. With neither set,
# /sitemap.xml returns 503 rather than guessing a domain.
# Set this to the real domain once it is registered. Leave it blank until
# then — a wrong canonical origin is worse than none.
PUBLIC_SITE_URL=""

# ------------------------------------------------------------------- Auth
# REQUIRED. Min 32 chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Rotating this immediately invalidates every admin session.
AUTH_SECRET=""

# Session lifetime in hours.
SESSION_TTL_HOURS=12

# Salt for hashing IPs before they are stored (rate limiting / abuse only).
# Generate the same way as AUTH_SECRET.
IP_HASH_SALT=""

# Set to "true" only when serving over HTTPS (sets the Secure cookie flag).
# MUST be true in production — the startup check refuses to boot otherwise,
# because a session cookie without Secure can be sent over plain HTTP.
COOKIE_SECURE=false

# ------------------------------------------------- First super admin setup
# Optional. Used once by `npm run admin:create` when you cannot run it
# interactively. Remove these after the account exists.
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_NAME=""
BOOTSTRAP_ADMIN_PASSWORD=""

# ------------------------------------------------------- Phone OTP / SMS
# Phone verification is MANDATORY before any enquiry is saved. If no
# provider is configured the server refuses enquiries rather than accepting
# them unverified, so this must be set before launch.
#
#   none     (default) OTP disabled -> enquiry forms are refused
#   console  dev only: prints the code to the server log. Refused when
#            NODE_ENV=production, because it would leak codes to logs.
#   twilio   Twilio REST API
#   webhook  POSTs {to, body} as JSON to your own gateway/relay
#            (MSG91, TextLocal, Gupshup, etc.)
SMS_PROVIDER=none

# --- twilio
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
# Sender ID or purchased number in E.164, e.g. "+15551234567"
TWILIO_FROM=""

# --- webhook
SMS_WEBHOOK_URL=""
# Optional; sent as "Authorization: Bearer <token>"
SMS_WEBHOOK_TOKEN=""

# --- OTP behaviour
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=45
# Ceiling per phone number per hour, across all source addresses.
OTP_MAX_SENDS_PER_HOUR=6

# How long a verified visitor stays signed in (hours). Default 30 days.
CUSTOMER_SESSION_TTL_HOURS=720

# ----------------------------------------------------------------- Storage
# "local" writes outside the web root and serves through a controlled route.
# Files are NOT placed in public/ and are never executed.
MEDIA_DRIVER=local
MEDIA_LOCAL_DIR="./server/storage"
MEDIA_MAX_IMAGE_MB=8
MEDIA_MAX_DOCUMENT_MB=20

# ------------------------------------------------------------------ Client
# Base URL the browser uses to reach the API. Leave blank to use a relative
# /api path (correct when the SPA and API share an origin behind one proxy).
VITE_API_BASE_URL="http://localhost:4000"
